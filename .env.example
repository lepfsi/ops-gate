# OpsGate API — copy to .env (never commit real secrets)

# Durable store (required in production)
DATABASE_URL=postgres://opsgate:opsgate@127.0.0.1:5432/opsgate

PORT=8787
# NODE_ENV=production

# Setup admin (DEMO defaults only for local dev)
OPSGATE_SETUP_EMAIL=admin@demo.local
OPSGATE_SETUP_PASSWORD=0000

# Vendor break-glass (agents offline ≥2h only) — change in production
OPSGATE_VENDOR_RECOVERY=OpsGate-Vendor-Recovery!

# Personal license keys (comma-separated)
OPSGATE_PERSONAL_LICENSE_KEYS=OPS-PERSONAL-DEMO-2026,OPS-HOME-TRIAL

# Optional: path to ed25519 private key for pack signing
# OPSGATE_SIGNING_PRIVATE_KEY_PATH=./packages/api/keys/ed25519-private.pem
