{
  "name": "@opsgate/proxy",
  "version": "0.2.0-p1",
  "description": "OpsGate local HTTPS proxy — P1 MITM observe allowlist + engine",
  "private": true,
  "type": "module",
  "bin": {
    "opsgate-proxy": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts serve",
    "serve": "tsx src/index.ts serve",
    "pac": "tsx src/index.ts pac",
    "inspect": "tsx src/index.ts inspect",
    "gen-ca": "tsx src/index.ts gen-ca",
    "ca-path": "tsx src/index.ts ca-path",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opsgate/engine": "workspace:*",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "20.11.5",
    "@types/node-forge": "^1.3.14",
    "tsx": "4.19.2",
    "typescript": "5.3.3"
  }
}
