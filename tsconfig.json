{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": [
    "node_modules",
    "build",
    "packages"
  ],
  "include": [
    ".plasmo/index.d.ts",
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./contents/**/*.ts",
    "./contents/**/*.tsx"
  ],
  "compilerOptions": {
    "strict": false,
    "paths": {
      "~*": [
        "./src/*"
      ]
    },
    "baseUrl": ".",
    "resolveJsonModule": true
  }
}
