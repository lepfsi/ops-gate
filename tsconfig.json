{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": [
    "node_modules",
    "build"
  ],
  "include": [
    ".plasmo/index.d.ts",
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "compilerOptions": {
    "strict": false,
    "paths": {
      "~*": [
        "./src/*"
      ]
    },
    "baseUrl": ".",
    "resolveJsonModule": true
  }
}
