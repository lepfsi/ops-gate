      "targets": [
        { "expr": "sum(opsgate_agents{status=\"total\"})", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Online",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
