  "panels": [
    {
      "type": "stat",
      "title": "API up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "opsgate_up",
          "refId": "A"
